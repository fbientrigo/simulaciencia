{
  "name": "@simulaciencia/classroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slidev classroom decks: Clase 01 (Poisson counting, primary) and the inverse-transform demonstration.",
  "scripts": {
    "dev": "slidev slides.md --open",
    "build": "slidev build slides.md --base ./ --out dist",
    "build:pages": "slidev build slides.md --base /simulaciencia/ --out dist-pages",
    "dev:demo": "slidev demo-inverse-transform.md --open",
    "build:demo": "slidev build demo-inverse-transform.md --base ./ --out dist-demo",
    "export": "slidev export slides.md",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --outDir dist"
  },
  "dependencies": {
    "@simulaciencia/case-inverse-transform": "workspace:*",
    "@simulaciencia/case-poisson-counting": "workspace:*",
    "@simulaciencia/case-radioactive-decay": "workspace:*",
    "@simulaciencia/core": "workspace:*",
    "@simulaciencia/schemas": "workspace:*",
    "@simulaciencia/theme": "workspace:*",
    "@simulaciencia/visuals": "workspace:*",
    "@slidev/cli": "52.18.1",
    "@slidev/theme-default": "0.25.0",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "vite": "8.2.0",
    "vue-tsc": "3.3.9"
  }
}
